<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Feliz Cumpleaños</title>
  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: #000;
      overflow: hidden;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
    }
  </style>
</head>
<body>

  
  <canvas id="canvas"></canvas>
  <script>
    const canvas = document.getElementById("canvas");
    const ctx = canvas.getContext("2d");
    let width = 0;
    let height = 0;
    
    let startTime = null;
    const INTRO_DURATION = 5200; 

    const floatParticles = [];
    const heartParticles = [];
    const HEART_COUNT = 1500;
    const BLUE_SHADES = [
      "#dbeafe", "#bfdbfe", "#93c5fd", "#60a5fa", 
      "#3b82f6", "#2563eb", "#1d4ed8", "#0f172a"
    ];

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    window.addEventListener("resize", resize);
    resize();

    function createFloatParticle() {
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.8 + 0.8,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        alpha: Math.random() * 0.8 + 0.2
      };
    }

    for (let i = 0; i < 180; i++) {
      floatParticles.push(createFloatParticle());
    }

    function generateHeartPoints() {

      const points = [];
      for (let i = 0; i < HEART_COUNT; i++) {
        const t = (i / HEART_COUNT) * Math.PI * 2;
        const x = 16 * Math.pow(Math.sin(t), 3);
        const y = 13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t);
        points.push({ x, y });
      }
      return points;
    }

    const heartPoints = generateHeartPoints();

    heartPoints.forEach((point, index) => {
      heartParticles.push({
        baseX: point.x * 9.8,
        baseY: -point.y * 9.8,
        x: 0,
        y: 0,
        r: Math.random() * 1.6 + 1.1,
        phase: Math.random() * Math.PI * 2,
        color: BLUE_SHADES[index % BLUE_SHADES.length]
      });
    });

    // Función de interpolación para un efecto suave con rebote al final
    function easeOutBack(x) {
      const c1 = 1.70158;
      const c3 = c1 + 1;
      return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
    }

    function drawFloatingParticles() {
  


      for (const p of floatParticles) {

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;


        ctx.beginPath();
        ctx.fillStyle = `rgba(147, 197, 253, ${p.alpha})`;
        ctx.shadowBlur = 10;
        ctx.shadowColor = "#93c5fd";
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.shadowBlur = 0;
    }

    function drawBaseGlow(cx, cy, introScale) {
      ctx.save();
      ctx.translate(cx, cy + 140);



      const grad = ctx.createRadialGradient(0, 0, 20 * introScale, 0, 0, 180 * introScale);
      grad.addColorStop(0, "rgba(96, 165, 250, 0.95)");
      grad.addColorStop(0.35, "rgba(59, 130, 246, 0.7)");
      grad.addColorStop(1, "rgba(0, 0, 0, 0)");

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.ellipse(0, 0, 150 * introScale, 34 * introScale, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
    


    function drawHeart(time, introScale) {
      const cx = width / 2;
      const cy = height / 2 + 10;
      const responsiveScale = Math.min(1, Math.min(width, height) / 520);

      for (let i = 0; i < heartParticles.length; i++) {
        const p = heartParticles[i];
        const pulse = 1 + Math.sin(time * 0.003 + p.phase) * 0.12;
        const driftX = Math.sin(time * 0.0015 + i * 0.18) * 2.5;
        const driftY = Math.cos(time * 0.0018 + i * 0.2) * 2.2;

        p.x = cx + (p.baseX * pulse * responsiveScale * introScale) + (driftX * introScale);
        p.y = cy + (p.baseY * pulse * responsiveScale * introScale) + (driftY * introScale);

        ctx.beginPath();
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 12;
        ctx.shadowColor = p.color;
        ctx.arc(p.x, p.y, p.r * Math.min(1, introScale), 0, Math.PI * 2); // También escala un poco el tamaño individual
        ctx.fill();
      }
      ctx.shadowBlur = 0;
      drawBaseGlow(cx, cy, Math.min(1, introScale));
    }

    function drawBirthdayText(time, introScale) {
      const cx = width / 2;
      const cy = height / 2 + 5;
      const fontSize = Math.min(52, Math.max(26, width * 0.085));
      const pulse = 1 + Math.sin(time * 0.003) * 0.03;

      ctx.save();
      ctx.translate(cx, cy);


      ctx.scale(pulse * introScale, pulse * introScale);
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.font = `bold ${fontSize}px Arial, sans-serif`;
      ctx.shadowBlur = 22;
      ctx.shadowColor = "#000";
      ctx.lineWidth = 4;
      ctx.strokeStyle = "#0f172a";
      ctx.strokeText("Feliz Cumpleaños", 0, 0);
      ctx.strokeText("My best friend", 0, 50);
      ctx.strokeText("<3", 0, -40);
      ctx.strokeText("≧◠‿◠≦✌", 0, -200);
      ctx.strokeText("💪 (`▿´) 👊", 0, -300);
      ctx.strokeText("ヾ(・ω・)メ(・ω・)ノ", 0, 230);
      ctx.strokeText("Together forever?", 0 , 280);



      ctx.shadowBlur = 18;
      ctx.shadowColor = "#60a5fa";
      ctx.fillStyle = "#60a5fa";
      ctx.fillText("Feliz Cumpleaños " , 0, 0);
      ctx.fillText("My best friend", 0, 50);
      ctx.fillText("<3", 0, -40);
      ctx.fillText("≧◠‿◠≦✌", 0, -200);
      ctx.fillText("💪 (`▿´) 👊", 0, -300);
      ctx.fillText("ヾ(・ω・)メ(・ω・)ノ", 0, 230);
      ctx.fillText("Together forever?", 0 , 280);
      ctx.restore();
    }
    

    function animate(time) {
      if (!startTime) startTime = time;
      const progress = Math.min(1, (time - startTime) / INTRO_DURATION);
      const introScale = easeOutBack(progress);

      ctx.fillStyle = "rgba(0, 0, 0, 0.35)";
      ctx.fillRect(0, 0, width, height);

      drawFloatingParticles();
      drawHeart(time, introScale);
      drawBirthdayText(time, introScale);

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  </script>
<audio controls autoplay loop>
    <source src="music.mp3" type="audio/mpeg">
</audio>

</body>
</html>
